@startuml ticket_booking_usecase
title Use Case Diagram: Ticketsathi Booking System

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho

actor "Guest User" as Guest
actor "Registered User" as User
actor "Administrator" as Admin
actor "Payment Gateway" as Payment

User --|> Guest

rectangle "Ticket Booking Core System" {

  together {
    (Browse Movies & Cinemas) as UC_Browse
    (View Showtimes) as UC_Showtimes
    (Register / Login) as UC_Login
  }

  together {
    (Select Seats) as UC_Seats
    (Make Payment) as UC_Payment
    (Cancel Booking) as UC_Cancel
    (View Booking History) as UC_History
    (Download E-Ticket) as UC_Ticket
  }

  together {
    (Manage Movies) as UC_Movies
    (Manage Cinemas & Screens) as UC_Cinemas
    (Schedule Showtimes) as UC_Schedule
    (Review Cancellations) as UC_Review
    (Process Refund) as UC_Refund
    (View Earnings) as UC_Earnings
  }

  UC_Browse -[hidden]right- UC_Seats
  UC_Seats  -[hidden]right- UC_Movies
}

' Guest (left)
Guest -- UC_Browse
Guest -- UC_Showtimes
Guest -- UC_Login

' Registered User (left)
User -- UC_Seats
User -- UC_Payment
User -- UC_Cancel
User -- UC_History
User -- UC_Ticket

' Payment Gateway (middle-bottom)
Payment -- UC_Payment

' Administrator (right)
Admin -- UC_Movies
Admin -- UC_Cinemas
Admin -- UC_Schedule
Admin -- UC_Review
Admin -- UC_Refund
Admin -- UC_Earnings

' Relationships
UC_Payment ..> UC_Seats   : <<include>>
UC_Seats   ..> UC_Login   : <<include>>
UC_Ticket  ..> UC_History : <<extend>>
UC_Refund  ..> UC_Review  : <<extend>>

@enduml